<?xml version="1.0" encoding="utf-8"?>
<!-- Notes are private: exclude them from cloud backup and device transfer until encrypted backup exists. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
